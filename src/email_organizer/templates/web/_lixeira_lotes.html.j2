{% if texto %}{% include "_toast.html.j2" %}{% endif %}
{% if lotes %}
<ul class="divide-y divide-slate-100">
  {% for l in lotes %}
  <li class="px-5 py-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-sm text-slate-700">{{ l.nome }}</span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs tabular-nums text-slate-600">{{ l.mensagens }} mensagem(ns)</span>
      <button type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-md border border-red-200 px-2.5 py-1 text-xs font-medium text-red-700 hover:bg-red-50"
              hx-post="/lixeira/excluir" hx-vals='{{ {"lote": l.nome} | tojson }}' hx-target="#lotes" hx-disabled-elt="this"
              hx-confirm="Apagar DEFINITIVAMENTE o lote {{ l.nome }} ({{ l.mensagens }} mensagens)? Não dá para desfazer.">
        <svg class="htmx-indicator animate-spin h-3 w-3" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/></svg>excluir definitivamente
      </button>
    </div>
    <ul class="mt-2 space-y-1">
      {% for i in l.itens %}
      <li class="flex items-center gap-2 text-sm">
        <span class="truncate text-slate-700">{{ i.caminho }}</span>
        <span class="text-xs text-slate-400">{{ i.mensagens }}</span>
        <button type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
                hx-post="/lixeira/restaurar" hx-vals='{{ {"lote": l.nome, "caminho": i.caminho} | tojson }}' hx-target="#lotes" hx-disabled-elt="this">
          <svg class="htmx-indicator animate-spin h-3 w-3" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/></svg>restaurar
        </button>
      </li>
      {% endfor %}
    </ul>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="px-5 py-6 text-sm text-slate-500">Lixeira vazia.</p>
{% endif %}
