{% extends 'base.html.j2' %}
{% from '_macros.html.j2' import spinner %}
{% block titulo %}Limpeza · email-organizer{% endblock %}
{% block conteudo %}
<main class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
  <section class="rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    <div class="border-b border-slate-100 px-5 py-3">
      <h2 class="font-semibold">Limpeza</h2>
      <p class="text-sm text-slate-500">Marque contas, remetentes, destinatários ou mensagens e mova para a <a href="/lixeira" class="text-indigo-600 hover:underline">lixeira</a>. Nada é apagado aqui; dá para restaurar depois.</p>
    </div>
    <form id="form-limpeza" hx-post="/limpeza/excluir" hx-target="#arvore" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
      <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 bg-slate-50 px-5 py-2 text-sm">
        <button type="button" class="text-slate-600 hover:text-slate-900" onclick="abrirTudo(true)">expandir</button>
        <button type="button" class="text-slate-600 hover:text-slate-900" onclick="abrirTudo(false)">recolher</button>
        <button type="button" class="text-slate-600 hover:text-slate-900" onclick="desmarcarTudo()">desmarcar tudo</button>
        <label class="ml-auto flex cursor-pointer items-center gap-1.5 text-slate-600" title="tira as mensagens do controle de já lidas (IMAP/Graph); PST sempre relê">
          <input type="checkbox" name="recapturar" value="true" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600"> voltam na próxima captura
        </label>
        <span class="text-slate-600"><span id="marcadas" class="font-semibold tabular-nums">0</span> mensagem(ns) marcada(s)</span>
        <button type="submit" id="btn-excluir" disabled class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-1.5 font-medium text-white shadow-sm hover:bg-red-700 disabled:bg-slate-300 disabled:cursor-not-allowed">
          {{ spinner() }}<span>Mover para a lixeira</span>
        </button>
      </div>
      <div id="arvore" class="px-3 py-3">{% include "_limpeza_arvore.html.j2" %}</div>
    </form>
  </section>
</main>
{% endblock %}
{% block scripts %}
{% with botao='btn-excluir' %}{% include '_arvore_js.html.j2' %}{% endwith %}
{% endblock %}
